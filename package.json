{
  "name": "sunfara-backend",
  "version": "2.0.0",
  "description": "LEGACY Express API archive only. Production commerce API is ASP.NET Core 9 Sunfara.Api (Railway Docker). Frontend SoT is sunfara/.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node -e \"console.error('QUARANTINED (ARCH-002): Express is legacy. Production API is Railway Docker → Sunfara.Api. See README and ops STACK_RUNBOOK.'); process.exit(1)\"",
    "dev": "node -e \"console.error('QUARANTINED (ARCH-002): Use: dotnet run --project sunfara-backend-dotnet/src/Sunfara.Api/Sunfara.Api.csproj (http://localhost:5187)'); process.exit(1)\"",
    "start:legacy-express": "node server.js",
    "dev:legacy-express": "nodemon server.js",
    "test": "node scripts/xss-escape-fixtures.mjs",
    "test:xss": "node scripts/xss-escape-fixtures.mjs",
    "assert:stack": "bash scripts/assert-authoritative-stack.sh",
    "lint": "eslint .",
    "migrate:server": "node -e \"console.error('QUARANTINED: migrate:server disabled (ARCH-002). Express must not replace Sunfara.Api.'); process.exit(1)\""
  },
  "keywords": ["ecommerce", "marketplace", "api", "firebase", "multi-vendor", "legacy-express"],
  "author": "Sunfara Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "firebase-admin": "^12.0.0",
    "dotenv": "^16.3.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.1.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "joi": "^17.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "@types/node": "^20.10.0"
  },
  "homepage": "https://github.com/yourusername/sunfara",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/sunfara.git"
  }
}
